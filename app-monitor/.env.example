APP_MONITOR_HOST=127.0.0.1
APP_MONITOR_PORT=8765
APP_MONITOR_TIMEZONE=Asia/Shanghai
APP_MONITOR_DATABASE=data/app-monitor.sqlite3
# 报价每天早上更新：从该时间起每 30 分钟检查一次，持续 3 小时，拿到当天报价即停止
APP_MONITOR_QUOTE_HOUR=9
APP_MONITOR_QUOTE_MINUTE=0
GOOFISH_BUNDLE_ID=com.taobao.fleamarket
GOOFISH_TRACK_DB=~/Library/Containers/com.taobao.fleamarket/Data/Library/walle_ut_user_track.db
# 选用 iPhone 时需要已签名的 WebDriverAgent；只保存 bundle ID，不保存登录凭据
APPIUM_SERVER_URL=http://127.0.0.1:4723
IOS_WDA_BUNDLE_ID=
IOS_WDA_DERIVED_DATA_PATH=/tmp/goofish-wda-probe

# 可选推送渠道；至少配置一个
NTFY_TOPIC_URL=
BARK_URL=
WEBHOOK_URL=
WEBHOOK_METHOD=POST
WEBHOOK_HEADERS=
WEBHOOK_CONTENT_TYPE=JSON
WEBHOOK_QUERY_PARAMETERS=
WEBHOOK_BODY=


# 地区、机型范围、成色、价差、搜索时段等监控规则在后台「监控规则」页配置，保存在数据库中

# 可选 AI 复核密钥；地址和模型在后台「监控规则 → 判价」配置
APP_MONITOR_AI_API_KEY=
